# =========================================================================
# Conexao com o banco PostgreSQL + PostGIS (Neon).
# No Neon, copie a "Connection string" e mantenha o ?sslmode=require no final.
# Ex.: postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# =========================================================================
DATABASE_URL=

# Porta do servidor. No Render isto e definido automaticamente.
PORT=3000

# Senha opcional para a pagina de importacao de GeoJSON (/importar). Se definida,
# a pagina exige esse token para gravar dados (cabecalho x-import-token). Deixe
# vazio em desenvolvimento; em producao (site publico) e RECOMENDADO definir,
# senao qualquer pessoa poderia importar ou apagar os dados territoriais.
IMPORT_TOKEN=

# =========================================================================
# Autenticacao (modulos Demandas e, futuramente, BCI).
# AUTH_ENABLED desligado (padrao): ninguem precisa fazer login; os modulos
# ficam abertos e a tabela de usuarios serve so como diretorio de membros da
# equipe (para atribuir responsaveis). Ligue com "true" para exigir login e
# aplicar os 3 perfis (admin/coordenador/tecnico) — usado na aprovacao do BCI.
# =========================================================================
AUTH_ENABLED=false
# Segredo para assinar os tokens (usado so quando AUTH_ENABLED=true).
# Em produção: obrigatório, aleatório, 32+ caracteres (openssl rand -hex 32).
AUTH_SECRET=
# Usuario administrador criado no primeiro boot (se a tabela estiver vazia).
ADMIN_EMAIL=admin@bzr.com
# Em produção: 12+ caracteres. Contas de demonstração (coordenador/tecnico/gestor) só fora de produção.
ADMIN_PASSWORD=
# Se "true" e nao houver demandas, carrega demandas de demonstracao no boot.
SEED_DEMANDAS_DEMO=false
# Se "true" e nao houver BCIs, carrega BCIs de demonstracao no boot.
SEED_BCI_DEMO=false

# Se "true" e o banco estiver VAZIO, carrega a cidade de demonstracao no boot.
# Util para um deploy de vitrine sem precisar rodar "npm run seed" manualmente.
# Deixe "false" quando for usar seus dados reais.
SEED_DEMO=false

# Se "true" e NAO houver nenhuma O.S., carrega ordens de servico de
# DEMONSTRACAO (Joao Pessoa) no boot — util para apresentar o modulo /os ao
# cliente. Nao apaga O.S. existentes. Tambem da para rodar "npm run seed-os".
# Deixe "false" quando for operar com dados reais.
SEED_OS_DEMO=false

# =========================================================================
# Camada de ORTOFOTO (tiles XYZ). Aceita {z}/{x}/{y} e, opcionalmente,
# {municipio} (substituido pela cidade selecionada, para uma ortofoto por
# cidade). Ex. multi-cidade no S3 (uma pasta por municipio):
#   https://eixo-ortofotos.s3.sa-east-1.amazonaws.com/{municipio}/{z}/{x}/{y}.png
# {municipio} vira um "slug" (minusculas, sem acento, espacos -> hifen). Ex.:
# "Tabira" -> tabira; "Catole do Rocha - PB" -> catole-do-rocha-pb. Nomeie as
# pastas no S3 com esse slug.
# Deixe vazio para usar a imagem de satelite publica (Esri) como referencia.
# Se SERVE_LOCAL_TILES=true e existir ./tiles/ortho, ela e exposta em
# /tiles/ortho/{z}/{x}/{y}.png automaticamente.
# =========================================================================
ORTHO_TILE_URL=
ORTHO_TILE_ATTRIBUTION=Ortofoto municipal
ORTHO_TILE_MINZOOM=0
ORTHO_TILE_MAXZOOM=22
SERVE_LOCAL_TILES=true

# =========================================================================
# Centro/zoom inicial do mapa (usado apenas se ainda nao houver dados
# carregados para calcular a extensao automaticamente).
# =========================================================================
MAP_CENTER_LAT=-22.0178
MAP_CENTER_LNG=-47.8908
MAP_ZOOM=14

# =========================================================================
# Modulo Ordens de Servico (/os) — sincronizacao de buracos reportados no
# Waze via BigQuery. Opcional: sem essas variaveis o modulo de O.S. funciona
# normalmente, so a sincronizacao com o Waze fica indisponivel.
# =========================================================================
WAZE_BQ_PROJECT=testes-waze
WAZE_BQ_DATASET=
WAZE_BQ_TABLE=
WAZE_BQ_LOCATION=US
# Token OAuth de curta duracao (~1h); normalmente informado pela tela de
# configuracao do /os em vez de fixado aqui. Gere com:
#   gcloud auth print-access-token
WAZE_TOKEN=

# =========================================================================
# PRODUÇÃO (NODE_ENV=production) — o servidor NÃO sobe se faltar algo abaixo.
# Demonstração: NODE_ENV=demo (ou vazio). Ver docs/operacao.md.
# =========================================================================
NODE_ENV=
# Município desta instância (um deploy por prefeitura — docs/adr/0001).
# Obrigatório em produção; a API ignora qualquer outro município.
MUNICIPIO=
# Endereço público https://…, impresso no QR dos documentos (obrigatório em produção).
PUBLIC_BASE_URL=
# Página da raiz: 'prefeitura' (página inicial da prefeitura) ou 'bzr' (apresentação da BzR).
# Vazio = prefeitura quando MUNICIPIO está definido. A BzR fica sempre em /bzr.
LANDING=
# Mostrar números do cadastro (imóveis, documentos) na página inicial (true/false).
PAGINA_NUMEROS=true
# Pacote contratado (vazio = todos): territorio,cib,documentos,bci,demandas,os,waze,api
MODULOS=

# Troca de município (docs/adr/0002): as OUTRAS prefeituras que a mesma equipe
# atende, cada uma com o seu deploy. Habilita o seletor de município no topo.
# Ex.: INSTANCIAS=Patos=https://patos.bzr.app.br; Sousa=https://sousa.bzr.app.br
INSTANCIAS=
# Mesmo valor em todas as instâncias da lista = troca sem digitar a senha de novo
# (ticket de 60 s, uso único; o usuário precisa estar cadastrado no destino).
# 32+ caracteres aleatórios, diferente do AUTH_SECRET. Vazio = pede login lá.
SSO_SECRET=

# =========================================================================
# Portal do Cidadão (/cidadao) — munícipe vê os imóveis do seu CPF/CNPJ, emite
# documentos e faz solicitações. O CPF sozinho NÃO dá acesso: exige gov.br,
# código no e-mail do cadastro ou a inscrição de um dos imóveis.
# =========================================================================
# Formas de entrada aceitas (em ordem): govbr, email, inscricao
PORTAL_ENTRADA=govbr,email,inscricao
# Documentos que o cidadão emite sozinho (vazio = padrão):
# certidao_cadastral,declaracao_situacao,certidao_valor_venal,certidao_numeracao,declaracao_cib,certidao_baixa
PORTAL_DOCUMENTOS=
# gov.br (Login Único): credenciais do credenciamento da prefeitura no gov.br.
# Redirect a cadastrar no gov.br: <PUBLIC_BASE_URL>/api/cidadao/govbr/retorno
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_AMBIENTE=homologacao
# E-mail do código de acesso (ex.: smtps://usuario:senha@smtp.prefeitura.gov.br:465)
SMTP_URL=
SMTP_FROM=Prefeitura <nao-responda@prefeitura.gov.br>

# =========================================================================
# CIB/Sinter + Documentos
# =========================================================================
# Demonstração (BLOQUEADOS em produção):
SEED_CIB_DEMO=false
CIB_SIMULAR_RETORNO=false
# Prazo legal padrão de integração ao Sinter (ajustável por município).
CIB_PRAZO_SINTER=2026-12-31
# Capacidade de saneamento (correções/semana) usada na estimativa do diagnóstico.
CIB_CAPACIDADE_SEMANAL=400
# API do Sinter (Manual Operacional 1.17). Sem credenciais, o envio é em lote:
# baixe o .zip da remessa, envie no portal/Swagger e informe o idArquivo.
SINTER_AMBIENTE=teste
SINTER_CLIENT_ID=
SINTER_CLIENT_SECRET=
# SINTER_BASE_URL=   (opcional: sobrepõe a tabela de ambientes)

# =========================================================================
# Mapa (municípios grandes): lotes e edificações só na área visível.
# =========================================================================
MAPA_ZOOM_DETALHE=14
MAPA_LIMITE_FEICOES=5000
MAPA_MAX_FEICOES=20000
